# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright auth state (contains Firebase tokens — do not commit)
tests/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep example committed)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.test
.env.production.local
.env.development
.env.production
!.env.example

# Backup files
*.backup
*.bak

# Secret files
secrets.txt
credentials.json
serviceAccountKey.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
