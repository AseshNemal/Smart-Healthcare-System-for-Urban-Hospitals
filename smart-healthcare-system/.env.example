# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` or `.env.local` (ignored by .gitignore).

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# NextAuth (if used)
# NEXTAUTH_SECRET=your-generated-secret
# NEXTAUTH_URL=http://localhost:3000

# Admin auth (local/dev defaults)
ADMIN_JWT_SECRET=change_me
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Urban Hospital Admin
ADMIN_PASSWORD=admin_password
ADMIN_SEED_TOKEN=seed-token

# Firebase (client-side keys should be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
